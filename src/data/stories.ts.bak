export const getStoryByCharacterId = (characterId: string): Story | undefined => {
  return stories.find(s => s.characterId === characterId);
};

export const getSceneById = (story: Story, sceneId: string): Scene | undefined => {
  return story.scenes.find(s => s.id === sceneId);
};